{
    "name": "keepr",
    "displayName": "KeepR",
    "description": "Code bookmarks with ticket tracking, statuses, and collapsible repo sections",
    "version": "0.1.7",
    "publisher": "wolfskii",
    "repository": {
        "type": "git",
        "url": "https://github.com/Wolfskii/KeepR"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "icon": "resources/icon.png",
    "contributes": {
        "commands": [
            {
                "command": "keepr.toggleBookmark",
                "title": "KeepR: Toggle Bookmark",
                "icon": "$(bookmark)"
            },
            {
                "command": "keepr.addBookmark",
                "title": "KeepR: Add Bookmark with Details",
                "icon": "$(add)"
            },
            {
                "command": "keepr.removeBookmark",
                "title": "KeepR: Remove Bookmark",
                "icon": "$(trash)"
            },
            {
                "command": "keepr.editBookmark",
                "title": "KeepR: Edit Bookmark",
                "icon": "$(edit)"
            },
            {
                "command": "keepr.goToBookmark",
                "title": "KeepR: Go to Bookmark"
            },
            {
                "command": "keepr.nextBookmark",
                "title": "KeepR: Next Bookmark"
            },
            {
                "command": "keepr.previousBookmark",
                "title": "KeepR: Previous Bookmark"
            },
            {
                "command": "keepr.clearAllBookmarks",
                "title": "KeepR: Clear All Bookmarks"
            },
            {
                "command": "keepr.toggleSectionCollapse",
                "title": "KeepR: Toggle Section Collapse"
            },
            {
                "command": "keepr.collapseAll",
                "title": "KeepR: Collapse All Sections",
                "icon": "$(collapse-all)"
            },
            {
                "command": "keepr.expandAll",
                "title": "KeepR: Expand All Sections",
                "icon": "$(expand-all)"
            },
            {
                "command": "keepr.filterByStatus",
                "title": "KeepR: Filter by Status",
                "icon": "$(filter)"
            },
            {
                "command": "keepr.filterByTicket",
                "title": "KeepR: Filter by Ticket",
                "icon": "$(search)"
            },
            {
                "command": "keepr.clearFilter",
                "title": "KeepR: Clear Filter",
                "icon": "$(clear-all)"
            },
            {
                "command": "keepr.renameRepo",
                "title": "KeepR: Rename Project",
                "icon": "$(edit)"
            },
            {
                "command": "keepr.revealBookmark",
                "title": "KeepR: Reveal Bookmark in Panel",
                "icon": "$(bookmark)"
            },
            {
                "command": "keepr.setAzureDevOpsPat",
                "title": "KeepR: Set Azure DevOps PAT"
            },
            {
                "command": "keepr.setGitHubToken",
                "title": "KeepR: Set GitHub Token"
            },
            {
                "command": "keepr.setJiraToken",
                "title": "KeepR: Set Jira API Token"
            },
            {
                "command": "keepr.setupProvider",
                "title": "KeepR: Set Up Ticket Provider",
                "icon": "$(plug)"
            },
            {
                "command": "keepr.openTicket",
                "title": "KeepR: Open Ticket in Browser",
                "icon": "$(link-external)"
            },
            {
                "command": "keepr.refreshWorkItems",
                "title": "KeepR: Refresh Work Item Status",
                "icon": "$(refresh)"
            },
            {
                "command": "keepr.addConnection",
                "title": "KeepR: Add Provider Connection",
                "icon": "$(add)"
            },
            {
                "command": "keepr.editConnection",
                "title": "KeepR: Edit Provider Connection",
                "icon": "$(edit)"
            },
            {
                "command": "keepr.removeConnection",
                "title": "KeepR: Remove Provider Connection",
                "icon": "$(trash)"
            },
            {
                "command": "keepr.activateConnection",
                "title": "KeepR: Set Active Provider Connection",
                "icon": "$(check)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "keepr",
                    "title": "KeepR",
                    "icon": "$(bookmark)"
                }
            ]
        },
        "views": {
            "keepr": [
                {
                    "id": "keepr.bookmarksView",
                    "name": "Bookmarks",
                    "icon": "$(bookmark)",
                    "contextualTitle": "KeepR"
                },
                {
                    "id": "keepr.providersView",
                    "name": "Providers",
                    "icon": "$(plug)",
                    "contextualTitle": "KeepR"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "keepr.addBookmark",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@1"
                },
                {
                    "command": "keepr.collapseAll",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@2"
                },
                {
                    "command": "keepr.expandAll",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@3"
                },
                {
                    "command": "keepr.filterByStatus",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@4"
                },
                {
                    "command": "keepr.clearFilter",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@5"
                },
                {
                    "command": "keepr.refreshWorkItems",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@6"
                },
                {
                    "command": "keepr.addConnection",
                    "when": "view == keepr.providersView",
                    "group": "navigation@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "keepr.editBookmark",
                    "when": "view == keepr.bookmarksView && viewItem == bookmark",
                    "group": "inline@1"
                },
                {
                    "command": "keepr.removeBookmark",
                    "when": "view == keepr.bookmarksView && viewItem == bookmark",
                    "group": "inline@2"
                },
                {
                    "command": "keepr.editBookmark",
                    "when": "view == keepr.bookmarksView && viewItem == bookmark",
                    "group": "1_actions@1"
                },
                {
                    "command": "keepr.removeBookmark",
                    "when": "view == keepr.bookmarksView && viewItem == bookmark",
                    "group": "1_actions@2"
                },
                {
                    "command": "keepr.openTicket",
                    "when": "view == keepr.bookmarksView && viewItem == bookmarkWithTicket",
                    "group": "inline@3"
                },
                {
                    "command": "keepr.openTicket",
                    "when": "view == keepr.bookmarksView && viewItem == bookmarkWithTicket",
                    "group": "1_actions@3"
                },
                {
                    "command": "keepr.renameRepo",
                    "when": "view == keepr.bookmarksView && viewItem == repo",
                    "group": "inline@1"
                },
                {
                    "command": "keepr.renameRepo",
                    "when": "view == keepr.bookmarksView && viewItem == repo",
                    "group": "1_actions@1"
                },
                {
                    "command": "keepr.editConnection",
                    "when": "view == keepr.providersView && viewItem =~ /connection|activeConnection/",
                    "group": "inline@1"
                },
                {
                    "command": "keepr.removeConnection",
                    "when": "view == keepr.providersView && viewItem =~ /connection|activeConnection/",
                    "group": "inline@2"
                },
                {
                    "command": "keepr.activateConnection",
                    "when": "view == keepr.providersView && viewItem == connection",
                    "group": "1_actions@1"
                },
                {
                    "command": "keepr.editConnection",
                    "when": "view == keepr.providersView && viewItem =~ /connection|activeConnection/",
                    "group": "1_actions@2"
                },
                {
                    "command": "keepr.removeConnection",
                    "when": "view == keepr.providersView && viewItem =~ /connection|activeConnection/",
                    "group": "1_actions@3"
                }
            ],
            "editor/context": [
                {
                    "command": "keepr.toggleBookmark",
                    "group": "keepr@1"
                },
                {
                    "command": "keepr.addBookmark",
                    "group": "keepr@2"
                }
            ],
            "editor/title": [
                {
                    "command": "keepr.toggleBookmark",
                    "group": "navigation",
                    "when": "editorTextFocus"
                }
            ]
        },
        "keybindings": [
            {
                "command": "keepr.toggleBookmark",
                "key": "ctrl+alt+k",
                "when": "editorTextFocus"
            },
            {
                "command": "keepr.addBookmark",
                "key": "ctrl+alt+shift+k",
                "when": "editorTextFocus"
            },
            {
                "command": "keepr.nextBookmark",
                "key": "ctrl+alt+l",
                "when": "editorTextFocus"
            },
            {
                "command": "keepr.previousBookmark",
                "key": "ctrl+alt+j",
                "when": "editorTextFocus"
            }
        ],
        "colors": [
            {
                "id": "keepr.bookmarkBackground",
                "description": "Background color for bookmarked lines",
                "defaults": {
                    "dark": "#2d2d0044",
                    "light": "#ffff0022",
                    "highContrast": "#ffff0044"
                }
            },
            {
                "id": "keepr.bookmarkBorder",
                "description": "Border color for bookmarked lines",
                "defaults": {
                    "dark": "#e2b714",
                    "light": "#b8960e",
                    "highContrast": "#ffcc00"
                }
            }
        ],
        "configuration": {
            "title": "KeepR",
            "properties": {
                "keepr.gutterIconEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show bookmark icons in the editor gutter"
                },
                "keepr.lineHighlightEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight bookmarked lines with a background color"
                },
                "keepr.defaultGroupBy": {
                    "type": "string",
                    "default": "repo",
                    "enum": [
                        "repo",
                        "file",
                        "status",
                        "ticket"
                    ],
                    "description": "Default grouping for the bookmarks tree view"
                },
                "keepr.statusLabels": {
                    "type": "array",
                    "default": [
                        "To Fix",
                        "Bug",
                        "Performance",
                        "Bad Practice",
                        "To Implement",
                        "Review",
                        "Note"
                    ],
                    "description": "Available status labels for bookmarks"
                },
                "keepr.ticketProvider": {
                    "type": "string",
                    "default": "",
                    "enum": [
                        "",
                        "azureDevOps",
                        "github",
                        "jira"
                    ],
                    "enumDescriptions": [
                        "None — manual ticket entry only",
                        "Azure DevOps — search work items, show state & branches",
                        "GitHub — search issues & PRs, show state & branches",
                        "Jira — search issues, show state & branches"
                    ],
                    "description": "Active ticket provider for search and live status"
                },
                "keepr.azureDevOps.orgUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Azure DevOps organization URL (e.g. https://dev.azure.com/myorg)"
                },
                "keepr.azureDevOps.project": {
                    "type": "string",
                    "default": "",
                    "description": "Azure DevOps project name"
                },
                "keepr.azureDevOps.pat": {
                    "type": "string",
                    "default": "",
                    "description": "Personal Access Token (prefer using the 'KeepR: Set Azure DevOps PAT' command for secure storage)"
                },
                "keepr.github.owner": {
                    "type": "string",
                    "default": "",
                    "description": "GitHub repository owner (user or org)"
                },
                "keepr.github.repo": {
                    "type": "string",
                    "default": "",
                    "description": "GitHub repository name"
                },
                "keepr.github.token": {
                    "type": "string",
                    "default": "",
                    "description": "GitHub Personal Access Token (prefer using the 'KeepR: Set GitHub Token' command for secure storage)"
                },
                "keepr.jira.hosting": {
                    "type": "string",
                    "default": "cloud",
                    "enum": [
                        "cloud",
                        "server"
                    ],
                    "enumDescriptions": [
                        "Jira Cloud (*.atlassian.net) — uses REST API v3 with email + API token",
                        "Jira Server / Data Center (self-hosted) — uses REST API v2 with username + password or PAT"
                    ],
                    "description": "Jira hosting type: 'cloud' for Atlassian Cloud or 'server' for self-hosted Jira Server / Data Center"
                },
                "keepr.jira.baseUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Jira instance base URL (e.g. https://mycompany.atlassian.net for Cloud, or https://jira.mycompany.com for Server)"
                },
                "keepr.jira.email": {
                    "type": "string",
                    "default": "",
                    "description": "Jira Cloud: account email address. Jira Server: username. Leave empty for PAT-only auth on Server/DC."
                },
                "keepr.jira.apiToken": {
                    "type": "string",
                    "default": "",
                    "description": "Jira API Token (prefer using the 'KeepR: Set Jira API Token' command for secure storage)"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "package": "vsce package",
        "publish": "vsce publish patch",
        "publish:minor": "vsce publish minor",
        "publish:patch": "vsce publish patch"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.3.0"
    }
}
