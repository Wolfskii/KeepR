{
    "name": "keepr",
    "displayName": "KeepR",
    "description": "Code bookmarks with ticket tracking, statuses, and collapsible repo sections",
    "version": "0.1.19",
    "publisher": "wolfskii",
    "repository": {
        "type": "git",
        "url": "https://github.com/Wolfskii/KeepR"
    },
    "engines": {
        "vscode": "^1.99.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "icon": "resources/icon.png",
    "contributes": {
        "commands": [
            {
                "command": "keepr.toggleBookmark",
                "title": "KeepR: Toggle Bookmark",
                "icon": "$(bookmark)"
            },
            {
                "command": "keepr.addBookmark",
                "title": "KeepR: Add Bookmark with Details",
                "icon": "$(add)"
            },
            {
                "command": "keepr.removeBookmark",
                "title": "KeepR: Remove Bookmark",
                "icon": "$(trash)"
            },
            {
                "command": "keepr.resolveBookmark",
                "title": "KeepR: Mark Bookmark as Resolved",
                "icon": "$(check)"
            },
            {
                "command": "keepr.resolveBookmarkById",
                "title": "KeepR: Resolve Bookmark by ID",
                "icon": "$(check)"
            },
            {
                "command": "keepr.removeBookmarkById",
                "title": "KeepR: Remove Bookmark by ID",
                "icon": "$(trash)"
            },
            {
                "command": "keepr.editBookmark",
                "title": "KeepR: Edit Bookmark",
                "icon": "$(edit)"
            },
            {
                "command": "keepr.goToBookmark",
                "title": "KeepR: Go to Bookmark"
            },
            {
                "command": "keepr.nextBookmark",
                "title": "KeepR: Next Bookmark"
            },
            {
                "command": "keepr.previousBookmark",
                "title": "KeepR: Previous Bookmark"
            },
            {
                "command": "keepr.clearAllBookmarks",
                "title": "KeepR: Clear All Bookmarks"
            },
            {
                "command": "keepr.toggleSectionCollapse",
                "title": "KeepR: Toggle Section Collapse"
            },
            {
                "command": "keepr.collapseAll",
                "title": "KeepR: Collapse All Sections",
                "icon": "$(collapse-all)"
            },
            {
                "command": "keepr.expandAll",
                "title": "KeepR: Expand All Sections",
                "icon": "$(expand-all)"
            },
            {
                "command": "keepr.filterByStatus",
                "title": "KeepR: Filter by Status",
                "icon": "$(filter)"
            },
            {
                "command": "keepr.filterByTicket",
                "title": "KeepR: Filter by Ticket",
                "icon": "$(search)"
            },
            {
                "command": "keepr.clearFilter",
                "title": "KeepR: Clear Filter",
                "icon": "$(clear-all)"
            },
            {
                "command": "keepr.renameRepo",
                "title": "KeepR: Rename Project",
                "icon": "$(edit)"
            },
            {
                "command": "keepr.revealBookmark",
                "title": "KeepR: Reveal Bookmark in Panel",
                "icon": "$(bookmark)"
            },
            {
                "command": "keepr.setupProvider",
                "title": "KeepR: Set Up Ticket Provider",
                "icon": "$(plug)"
            },
            {
                "command": "keepr.openTicket",
                "title": "KeepR: Open Ticket in Browser",
                "icon": "$(link-external)"
            },
            {
                "command": "keepr.refreshWorkItems",
                "title": "KeepR: Refresh Work Item Status",
                "icon": "$(refresh)"
            },
            {
                "command": "keepr.refreshMyItems",
                "title": "KeepR: Refresh My Tickets and PRs",
                "icon": "$(refresh)"
            },
            {
                "command": "keepr.setMyItemsTicketFilter",
                "title": "KeepR: Set My Tickets Filter",
                "icon": "$(filter)"
            },
            {
                "command": "keepr.setMyItemsPrFilter",
                "title": "KeepR: Set My PRs Filter",
                "icon": "$(filter)"
            },
            {
                "command": "keepr.setMyItemsSort",
                "title": "KeepR: Set My Items Sort",
                "icon": "$(list-selection)"
            },
            {
                "command": "keepr.addConnection",
                "title": "KeepR: Add Provider Connection",
                "icon": "$(add)"
            },
            {
                "command": "keepr.editConnection",
                "title": "KeepR: Edit Provider Connection",
                "icon": "$(edit)"
            },
            {
                "command": "keepr.removeConnection",
                "title": "KeepR: Remove Provider Connection",
                "icon": "$(trash)"
            },
            {
                "command": "keepr.activateConnection",
                "title": "KeepR: Set Active Provider Connection",
                "icon": "$(check)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "keepr",
                    "title": "KeepR",
                    "icon": "$(bookmark)"
                }
            ]
        },
        "views": {
            "keepr": [
                {
                    "id": "keepr.bookmarksView",
                    "name": "Bookmarks",
                    "icon": "$(bookmark)",
                    "contextualTitle": "KeepR"
                },
                {
                    "id": "keepr.providersView",
                    "name": "Providers",
                    "icon": "$(plug)",
                    "contextualTitle": "KeepR"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "keepr.addBookmark",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@1"
                },
                {
                    "command": "keepr.collapseAll",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@2"
                },
                {
                    "command": "keepr.expandAll",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@3"
                },
                {
                    "command": "keepr.filterByStatus",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@4"
                },
                {
                    "command": "keepr.clearFilter",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@5"
                },
                {
                    "command": "keepr.refreshWorkItems",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@6"
                },
                {
                    "command": "keepr.refreshMyItems",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@7"
                },
                {
                    "command": "keepr.setMyItemsTicketFilter",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@8"
                },
                {
                    "command": "keepr.setMyItemsPrFilter",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@9"
                },
                {
                    "command": "keepr.setMyItemsSort",
                    "when": "view == keepr.bookmarksView",
                    "group": "navigation@10"
                },
                {
                    "command": "keepr.addConnection",
                    "when": "view == keepr.providersView",
                    "group": "navigation@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "keepr.editBookmark",
                    "when": "view == keepr.bookmarksView && viewItem =~ /bookmark/",
                    "group": "inline@1"
                },
                {
                    "command": "keepr.removeBookmark",
                    "when": "view == keepr.bookmarksView && viewItem =~ /bookmark/",
                    "group": "inline@2"
                },
                {
                    "command": "keepr.resolveBookmark",
                    "when": "view == keepr.bookmarksView && viewItem =~ /bookmark/",
                    "group": "inline@3"
                },
                {
                    "command": "keepr.editBookmark",
                    "when": "view == keepr.bookmarksView && viewItem =~ /bookmark/",
                    "group": "1_actions@1"
                },
                {
                    "command": "keepr.removeBookmark",
                    "when": "view == keepr.bookmarksView && viewItem =~ /bookmark/",
                    "group": "1_actions@2"
                },
                {
                    "command": "keepr.resolveBookmark",
                    "when": "view == keepr.bookmarksView && viewItem =~ /bookmark/",
                    "group": "1_actions@3"
                },
                {
                    "command": "keepr.openTicket",
                    "when": "view == keepr.bookmarksView && viewItem == bookmarkWithTicket",
                    "group": "inline@4"
                },
                {
                    "command": "keepr.openTicket",
                    "when": "view == keepr.bookmarksView && viewItem == bookmarkWithTicket",
                    "group": "1_actions@4"
                },
                {
                    "command": "keepr.renameRepo",
                    "when": "view == keepr.bookmarksView && viewItem == repo",
                    "group": "inline@1"
                },
                {
                    "command": "keepr.renameRepo",
                    "when": "view == keepr.bookmarksView && viewItem == repo",
                    "group": "1_actions@1"
                },
                {
                    "command": "keepr.editConnection",
                    "when": "view == keepr.providersView && viewItem =~ /connection|activeConnection/",
                    "group": "inline@1"
                },
                {
                    "command": "keepr.removeConnection",
                    "when": "view == keepr.providersView && viewItem =~ /connection|activeConnection/",
                    "group": "inline@2"
                },
                {
                    "command": "keepr.activateConnection",
                    "when": "view == keepr.providersView && viewItem == connection",
                    "group": "1_actions@1"
                },
                {
                    "command": "keepr.editConnection",
                    "when": "view == keepr.providersView && viewItem =~ /connection|activeConnection/",
                    "group": "1_actions@2"
                },
                {
                    "command": "keepr.removeConnection",
                    "when": "view == keepr.providersView && viewItem =~ /connection|activeConnection/",
                    "group": "1_actions@3"
                }
            ],
            "editor/context": [
                {
                    "command": "keepr.toggleBookmark",
                    "group": "keepr@1"
                },
                {
                    "command": "keepr.addBookmark",
                    "group": "keepr@2"
                }
            ],
            "editor/title": [
                {
                    "command": "keepr.toggleBookmark",
                    "group": "navigation",
                    "when": "editorTextFocus"
                }
            ]
        },
        "keybindings": [
            {
                "command": "keepr.toggleBookmark",
                "key": "ctrl+alt+k",
                "when": "editorTextFocus"
            },
            {
                "command": "keepr.addBookmark",
                "key": "ctrl+alt+shift+k",
                "when": "editorTextFocus"
            },
            {
                "command": "keepr.nextBookmark",
                "key": "ctrl+alt+l",
                "when": "editorTextFocus"
            },
            {
                "command": "keepr.previousBookmark",
                "key": "ctrl+alt+j",
                "when": "editorTextFocus"
            }
        ],
        "colors": [
            {
                "id": "keepr.bookmarkBackground",
                "description": "Background color for bookmarked lines",
                "defaults": {
                    "dark": "#2d2d0044",
                    "light": "#ffff0022",
                    "highContrast": "#ffff0044"
                }
            },
            {
                "id": "keepr.bookmarkBorder",
                "description": "Border color for bookmarked lines",
                "defaults": {
                    "dark": "#e2b714",
                    "light": "#b8960e",
                    "highContrast": "#ffcc00"
                }
            }
        ],
        "languageModelTools": [
            {
                "name": "keepr_listBookmarks",
                "displayName": "List Bookmarks",
                "modelDescription": "List all KeepR code bookmarks in the workspace. Can optionally filter by status, ticket number, or file path. Returns bookmark details including file path, line number, label, status, and linked ticket.",
                "icon": "$(bookmark)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "status": {
                            "type": "string",
                            "description": "Filter by status (e.g. 'Bug', 'To Fix', 'Performance', 'To Implement', 'Review', 'Note')"
                        },
                        "ticket": {
                            "type": "string",
                            "description": "Filter by ticket/PBI number"
                        },
                        "filePath": {
                            "type": "string",
                            "description": "Filter by file path (substring match)"
                        }
                    }
                }
            },
            {
                "name": "keepr_addBookmark",
                "displayName": "Add Bookmark",
                "modelDescription": "Add a KeepR code bookmark at a specific file and line. Optionally attach a label, ticket number, and status.",
                "icon": "$(add)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "filePath": {
                            "type": "string",
                            "description": "Workspace-relative or absolute file path to bookmark"
                        },
                        "line": {
                            "type": "number",
                            "description": "1-based line number to bookmark"
                        },
                        "label": {
                            "type": "string",
                            "description": "Optional label/note for the bookmark"
                        },
                        "ticket": {
                            "type": "string",
                            "description": "Optional ticket/PBI number to link"
                        },
                        "status": {
                            "type": "string",
                            "description": "Optional status: 'To Fix', 'Bug', 'Performance', 'Bad Practice', 'To Implement', 'Review', 'Note', 'Resolved'"
                        }
                    },
                    "required": [
                        "filePath",
                        "line"
                    ]
                }
            },
            {
                "name": "keepr_removeBookmark",
                "displayName": "Remove Bookmark",
                "modelDescription": "Remove a KeepR bookmark by its ID, or by file path and line number.",
                "icon": "$(trash)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "The bookmark ID to remove"
                        },
                        "filePath": {
                            "type": "string",
                            "description": "File path of the bookmark to remove (used with line)"
                        },
                        "line": {
                            "type": "number",
                            "description": "1-based line number of the bookmark to remove (used with filePath)"
                        }
                    }
                }
            },
            {
                "name": "keepr_getStats",
                "displayName": "Bookmark Statistics",
                "modelDescription": "Get statistics about KeepR bookmarks: total count, breakdown by status, breakdown by ticket, and breakdown by repo/project.",
                "icon": "$(graph)",
                "inputSchema": {
                    "type": "object",
                    "properties": {}
                }
            },
            {
                "name": "keepr_editBookmark",
                "displayName": "Edit Bookmark",
                "modelDescription": "Edit an existing KeepR bookmark's label, ticket, or status. Identify the bookmark by its ID (from keepr_listBookmarks) or by file path + line number.",
                "icon": "$(edit)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "The bookmark ID to edit"
                        },
                        "filePath": {
                            "type": "string",
                            "description": "File path of the bookmark to edit (used with line)"
                        },
                        "line": {
                            "type": "number",
                            "description": "1-based line number of the bookmark to edit (used with filePath)"
                        },
                        "label": {
                            "type": "string",
                            "description": "New label/note (empty string to clear)"
                        },
                        "ticket": {
                            "type": "string",
                            "description": "New ticket/PBI number (empty string to clear)"
                        },
                        "status": {
                            "type": "string",
                            "description": "New status: 'To Fix', 'Bug', 'Performance', 'Bad Practice', 'To Implement', 'Review', 'Note', 'Resolved' (empty string to clear)"
                        }
                    }
                }
            },
            {
                "name": "keepr_getConnections",
                "displayName": "Get Provider Connections",
                "modelDescription": "List all configured ticket provider connections (Azure DevOps, GitHub, Jira) and which one is active. Shows connection names, types, and non-secret config (org URLs, project names, etc.) but never tokens or PATs. If no connections exist, tells the user how to set one up.",
                "icon": "$(plug)",
                "inputSchema": {
                    "type": "object",
                    "properties": {}
                }
            },
            {
                "name": "keepr_getTicketDetails",
                "displayName": "Get Ticket Details",
                "modelDescription": "Fetch live details for a ticket/work item linked to a bookmark, using the active ticket provider. Returns the ticket's state, type, title, assigned person, parent/child hierarchy when available, board column (Azure DevOps), description/acceptance criteria when available, associated branches, and pull requests. Can look up by ticket ID directly, or fetch details for all bookmarks that have linked tickets.",
                "icon": "$(link-external)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "ticketId": {
                            "type": "string",
                            "description": "Specific ticket/PBI ID to look up"
                        },
                        "all": {
                            "type": "boolean",
                            "description": "If true, fetch details for all unique tickets linked to bookmarks"
                        }
                    }
                }
            },
            {
                "name": "keepr_searchTickets",
                "displayName": "Search Tickets",
                "modelDescription": "Search the active provider (Azure DevOps, GitHub, or Jira) for work items/issues/pull requests by ID or free-text query. Returns matching ticket IDs, titles, states, types, assignees, and URLs.",
                "icon": "$(search)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "Search string, ticket id, or PBI number"
                        }
                    },
                    "required": [
                        "query"
                    ]
                }
            },
            {
                "name": "keepr_getHierarchy",
                "displayName": "Get Ticket Hierarchy",
                "modelDescription": "Return only parent/child hierarchy for a ticket or for all tickets linked to bookmarks. Useful for feature -> PBI -> task views.",
                "icon": "$(type-hierarchy)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "ticketId": {
                            "type": "string",
                            "description": "Ticket/PBI ID to build hierarchy for"
                        },
                        "all": {
                            "type": "boolean",
                            "description": "If true, build hierarchy for all linked ticket IDs"
                        },
                        "depth": {
                            "type": "number",
                            "description": "Child depth to expand (1-5, default 2)"
                        }
                    }
                }
            },
            {
                "name": "keepr_getMyItems",
                "displayName": "Get My Items",
                "modelDescription": "Get tickets/PBIs/features and pull requests related to the logged-in user across all configured providers, with relation/state/provider filtering and sorting.",
                "icon": "$(account)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "scope": {
                            "type": "string",
                            "description": "What to return: tickets, pullRequests, or all"
                        },
                        "relation": {
                            "type": "string",
                            "description": "Relation filter, e.g. reviewer, approved, authored, assigned, mentioned, commented"
                        },
                        "state": {
                            "type": "string",
                            "description": "State/status filter, e.g. open, active, draft"
                        },
                        "provider": {
                            "type": "string",
                            "description": "Provider name filter, e.g. azure, github, jira"
                        },
                        "sortBy": {
                            "type": "string",
                            "description": "Sort by updated, created, title, or provider"
                        },
                        "limit": {
                            "type": "number",
                            "description": "Maximum returned items per scope (1-200, default 50)"
                        }
                    }
                }
            }
        ],
        "configuration": {
            "title": "KeepR",
            "properties": {
                "keepr.gutterIconEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show bookmark icons in the editor gutter"
                },
                "keepr.lineHighlightEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight bookmarked lines with a background color"
                },
                "keepr.inlineActionsEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show inline Resolve/Remove actions on bookmarked rows"
                },
                "keepr.myItems.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show My Tickets/PBIs/Features and My Pull Requests sections in the Bookmarks view"
                },
                "keepr.myItems.ticketFilter": {
                    "type": "string",
                    "default": "all",
                    "enum": [
                        "all",
                        "assigned",
                        "created",
                        "mentioned",
                        "commented",
                        "involved"
                    ],
                    "description": "Filter for My Tickets/PBIs/Features section"
                },
                "keepr.myItems.prFilter": {
                    "type": "string",
                    "default": "all",
                    "enum": [
                        "all",
                        "authored",
                        "reviewer",
                        "approved",
                        "mentioned",
                        "commented",
                        "involved"
                    ],
                    "description": "Filter for My Pull Requests section"
                },
                "keepr.myItems.sortBy": {
                    "type": "string",
                    "default": "updated",
                    "enum": [
                        "updated",
                        "created",
                        "title",
                        "provider"
                    ],
                    "description": "Sort order for My Tickets and My Pull Requests sections"
                },
                "keepr.defaultGroupBy": {
                    "type": "string",
                    "default": "repo",
                    "enum": [
                        "repo",
                        "file",
                        "status",
                        "ticket"
                    ],
                    "description": "Default grouping for the bookmarks tree view"
                },
                "keepr.statusLabels": {
                    "type": "array",
                    "default": [
                        "To Fix",
                        "Bug",
                        "Performance",
                        "Bad Practice",
                        "To Implement",
                        "Review",
                        "Note",
                        "Resolved"
                    ],
                    "description": "Available status labels for bookmarks"
                },
                "keepr.ticketProvider": {
                    "type": "string",
                    "default": "",
                    "enum": [
                        "",
                        "azureDevOps",
                        "github",
                        "jira"
                    ],
                    "enumDescriptions": [
                        "None — manual ticket entry only",
                        "Azure DevOps — search work items, show state & branches",
                        "GitHub — search issues & PRs, show state & branches",
                        "Jira — search issues, show state & branches"
                    ],
                    "description": "Active ticket provider for search and live status"
                },
                "keepr.azureDevOps.orgUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Azure DevOps organization URL (e.g. https://dev.azure.com/myorg)"
                },
                "keepr.azureDevOps.project": {
                    "type": "string",
                    "default": "",
                    "description": "Azure DevOps project name"
                },
                "keepr.azureDevOps.pat": {
                    "type": "string",
                    "default": "",
                    "description": "Personal Access Token (prefer using the 'KeepR: Set Azure DevOps PAT' command for secure storage)"
                },
                "keepr.github.owner": {
                    "type": "string",
                    "default": "",
                    "description": "GitHub repository owner (user or org)"
                },
                "keepr.github.repo": {
                    "type": "string",
                    "default": "",
                    "description": "GitHub repository name"
                },
                "keepr.github.token": {
                    "type": "string",
                    "default": "",
                    "description": "GitHub Personal Access Token (prefer using the 'KeepR: Set GitHub Token' command for secure storage)"
                },
                "keepr.jira.hosting": {
                    "type": "string",
                    "default": "cloud",
                    "enum": [
                        "cloud",
                        "server"
                    ],
                    "enumDescriptions": [
                        "Jira Cloud (*.atlassian.net) — uses REST API v3 with email + API token",
                        "Jira Server / Data Center (self-hosted) — uses REST API v2 with username + password or PAT"
                    ],
                    "description": "Jira hosting type: 'cloud' for Atlassian Cloud or 'server' for self-hosted Jira Server / Data Center"
                },
                "keepr.jira.baseUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Jira instance base URL (e.g. https://mycompany.atlassian.net for Cloud, or https://jira.mycompany.com for Server)"
                },
                "keepr.jira.email": {
                    "type": "string",
                    "default": "",
                    "description": "Jira Cloud: account email address. Jira Server: username. Leave empty for PAT-only auth on Server/DC."
                },
                "keepr.jira.apiToken": {
                    "type": "string",
                    "default": "",
                    "description": "Jira API Token (prefer using the 'KeepR: Set Jira API Token' command for secure storage)"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "package": "vsce package",
        "publish": "node scripts/publish.js patch",
        "publish:minor": "node scripts/publish.js minor",
        "publish:local": "npm version patch --no-git-tag-version && vsce package"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.99.0",
        "typescript": "^5.3.0"
    }
}
